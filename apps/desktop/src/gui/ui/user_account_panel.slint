// CrossDesk - user account login and device group list
//
// Follows the project's existing Slint conventions:
//   - FlatSurface / UiSurface from ui_surface.slint for cards and outlines
//   - WorkbenchStyle from workbench_controls.slint for text colors
//   - SettingsButton from settings_controls.slint for buttons
//   - RoundedLineEdit from rounded_line_edit.slint for inputs
//   - Strings centralized in UserAccountStrings, injected from C++
//
// NOTE: all comments are ASCII to avoid encoding corruption on upload.

import { FlatSurface, UiSurface } from "ui_surface.slint";
import { UiRadius } from "ui_radius.slint";
import { WorkbenchStyle } from "workbench_controls.slint";
import { SettingsButton } from "settings_controls.slint";
import { RoundedLineEdit } from "rounded_line_edit.slint";

// ---- Strings injected by C++ per language ----
export global UserAccountStrings {
    in-out property <string> panel-title: "Account";
    in-out property <string> username-label: "Username";
    in-out property <string> password-label: "Password";
    in-out property <string> sign-in: "Sign in";
    in-out property <string> signing-in: "Signing in...";
    in-out property <string> sign-out: "Sign out";
    in-out property <string> my-devices: "My devices";
    in-out property <string> no-devices: "No devices assigned to your account yet.";
    in-out property <string> online: "Online";
    in-out property <string> offline: "Offline";
    in-out property <string> connect: "Connect";
    in-out property <string> refresh: "Refresh";
}

// ---- Data models ----
export struct UserDeviceEntry {
    device-id: string,
    alias: string,
    online: bool,
}

export struct UserGroupEntry {
    group-id: int,
    group-name: string,
    device-count: int,
}

// ---- One device row ----
component UserDeviceRow inherits FlatSurface {
    in property <UserDeviceEntry> device;
    callback connect-requested;

    height: 52px;
    background: white;
    outline-color: UiSurface.edge;
    border-radius: UiRadius.control;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        // Online status dot
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.device.online ? #1a7f37 : #94a3b8;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;

            Text {
                text: root.device.alias != "" ? root.device.alias : root.device.device-id;
                font-size: 12px;
                font-weight: 600;
                color: WorkbenchStyle.text;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.device.device-id + "  /  "
                    + (root.device.online ? UserAccountStrings.online : UserAccountStrings.offline);
                font-size: 10px;
                color: WorkbenchStyle.muted;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        SettingsButton {
            width: min(90px, max(64px, self.label-width));
            height: 28px;
            text-size: 11px;
            text: UserAccountStrings.connect;
            enabled: root.device.online;
            clicked => { root.connect-requested(); }
        }
    }
}

// ---- Main panel ----
export component UserAccountPanel inherits Rectangle {
    // Strings
    in-out property <string> title-text: UserAccountStrings.panel-title;
    in-out property <string> username-text: UserAccountStrings.username-label;
    in-out property <string> password-text: UserAccountStrings.password-label;
    in-out property <string> sign-in-text: UserAccountStrings.sign-in;
    in-out property <string> signing-in-text: UserAccountStrings.signing-in;
    in-out property <string> sign-out-text: UserAccountStrings.sign-out;
    in-out property <string> devices-title-text: UserAccountStrings.my-devices;
    in-out property <string> no-devices-text: UserAccountStrings.no-devices;
    in-out property <string> refresh-text: UserAccountStrings.refresh;

    // State
    in-out property <bool> signed-in: false;
    in-out property <bool> signing-in: false;
    in-out property <bool> busy: false;
    in-out property <string> error-text: "";
    in-out property <string> display-name: "";

    // Form
    in-out property <string> input-username: "";
    in-out property <string> input-password: "";

    // Data
    in-out property <[UserDeviceEntry]> devices: [];

    // Callbacks
    callback sign-in-requested;
    callback sign-out-requested;
    callback refresh-requested;
    callback device-connect-requested(string);

    background: transparent;

    VerticalLayout {
        spacing: 10px;

        // ===== Header =====
        HorizontalLayout {
            spacing: 8px;

            Text {
                text: root.title-text;
                font-size: 13px;
                font-weight: 600;
                color: WorkbenchStyle.text;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            if root.signed-in : Text {
                text: root.display-name;
                font-size: 11px;
                color: WorkbenchStyle.muted;
                vertical-alignment: center;
            }

            if root.signed-in : SettingsButton {
                width: min(96px, max(64px, self.label-width));
                height: 28px;
                text-size: 11px;
                quiet: true;
                text: root.sign-out-text;
                clicked => { root.sign-out-requested(); }
            }
        }

        // ===== Signed out: login form =====
        if !root.signed-in : VerticalLayout {
            spacing: 8px;

            Text {
                text: root.username-text;
                font-size: 11px;
                color: WorkbenchStyle.muted;
                vertical-alignment: center;
            }
            RoundedLineEdit {
                text <=> root.input-username;
                enabled: !root.signing-in;
                placeholder-text: root.username-text;
            }

            Text {
                text: root.password-text;
                font-size: 11px;
                color: WorkbenchStyle.muted;
                vertical-alignment: center;
            }
            RoundedLineEdit {
                text <=> root.input-password;
                input-type: password;
                enabled: !root.signing-in;
                placeholder-text: root.password-text;
                accepted => { root.sign-in-requested(); }
            }

            if root.error-text != "" : Text {
                text: root.error-text;
                font-size: 11px;
                color: UiSurface.error;
                wrap: word-wrap;
            }

            SettingsButton {
                width: min(160px, max(96px, self.label-width));
                height: 30px;
                primary: true;
                text-size: 11px;
                enabled: !root.signing-in
                    && root.input-username != ""
                    && root.input-password != "";
                text: root.signing-in ? root.signing-in-text : root.sign-in-text;
                clicked => { root.sign-in-requested(); }
            }
        }

        // ===== Signed in: device list =====
        if root.signed-in : VerticalLayout {
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.devices-title-text;
                    font-size: 12px;
                    font-weight: 600;
                    color: WorkbenchStyle.text;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                SettingsButton {
                    width: min(80px, max(64px, self.label-width));
                    height: 26px;
                    text-size: 10px;
                    quiet: true;
                    text: root.refresh-text;
                    enabled: !root.busy;
                    clicked => { root.refresh-requested(); }
                }
            }

            if root.devices.length == 0 : Text {
                text: root.no-devices-text;
                font-size: 11px;
                color: WorkbenchStyle.muted;
                wrap: word-wrap;
            }

            for device[i] in root.devices : UserDeviceRow {
                device: device;
                connect-requested => {
                    root.device-connect-requested(device.device-id);
                }
            }
        }
    }
}
